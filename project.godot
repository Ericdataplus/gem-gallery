; Engine configuration file.

config_version=5

[application]

config/name="Gem Gallery"
config/description="Walkable void gallery of real-world gems, minerals, crowns and treasures. Halls are baked scenes streamed at runtime."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/initial_screen=0
window/stretch/mode="canvas_items"

[rendering]

lights_and_shadows/directional_shadow/size=8192
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
scaling_3d/mode=2
scaling_3d/scale=0.77
scaling_3d/fsr_sharpness=0.15
environment/defaults/default_clear_color=Color(0.035, 0.036, 0.042, 1)
